
# APP
APP_NAME=Northwind Enterprise API
APP_VERSION=1.0.0
DEBUG=True


# DB
DB_USER=northwind_user
DB_PASSWORD=northwind_password
DB_NAME=northwind
DB_PORT=5432
DB_HOST=northwind_postgres


# PGADMIN (solo para docker-compose)
PGADMIN_EMAIL=admin@northwind.com
PGADMIN_PASSWORD=admin123


# JWT
# GENERA UNA CLAVE REAL, nunca dejes el valor de ejemplo.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Con DEBUG=False la app se niega a arrancar si la clave sigue siendo de ejemplo.
JWT_SECRET_KEY=CHANGE-THIS-TO-A-SECRET-KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MIN=40


# CORS
# Lista en formato JSON con los origins permitidos. No uses "*" mientras
# CORS_ALLOW_CREDENTIALS sea True: la app aborta el arranque si lo haces.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:8000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type","Accept"]


# REDIS
REDIS_PORT=6379
REDIS_HOST=northwind_redis
